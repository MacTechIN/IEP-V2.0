# V1 호환성 파일 (분리 운영)
node_modules/
.env
.env.local
.DS_Store
*.log
# 다만 서비스 점검 기록은 남긴다 — 이건 산출물이 아니라 기록이다.
!docs/health/*.log

# 빌드 산출물
dist/
build/
.next/
out/

# IDE
.vscode/
.idea/
*.swp
*.swo

# 테스트 커버리지
coverage/
.nyc_output/

# 임시 파일
*.tmp
.cache/
temp/

# V1과의 혼동 방지
!../mvp/  # V1은 별도 폴더에서 운영

# production env files (contain real secrets — never commit)
.env.production
.env.production.*
deploy/.env.production

# temp audio for upload testing
*.wav

# self-signed certs (never commit private key)
deploy/web/certs/

# 호스트에서 생성하는 자체서명 인증서 — 저장소에 두지 않는다
deploy/web/certs/

# Worker 프로브 시크릿 — 로컬 전용
worker/.probe-secret.local
worker/node_modules/
worker/.wrangler/

# Cloud Run 스트림 서비스
stream-service/node_modules/
stream-service/dist/

# tsc -b 부산물 — 소스가 아니다
*.tsbuildinfo
frontend/web/vite.config.js
frontend/web/vite.config.d.ts

# **LEP 것이 아니다.** 2026-08-26 에 `git add -A` 가 3.5GB 를 통째로 커밋했다 —
# 저장소 안에 남의 작업 폴더가 있으면 언젠가 또 들어간다. 코드로 막는다.
UYTELL_ORG_ANALYSIS/
