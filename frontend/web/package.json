{
  "name": "@iep/web",
  "version": "0.3.0",
  "description": "LEP (Lawyer's Enablement Platform) Web Dashboard",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:chunks": "node tests/chunk-bounds.test.mjs",
    "test:auth": "VITE_API_URL=http://127.0.0.1:4571/api/v2 vitest run tests/auth-refresh-loop.test.ts",
    "test:export": "TZ=Asia/Seoul vitest run tests/transcript-export.test.ts",
    "build:prod": "VITE_API_URL=https://iep-api.wooriszhome.workers.dev/api/v2 vite build",
    "deploy": "npm run build:prod && npm run check:bundle && npx wrangler pages deploy dist --project-name iep-web",
    "check:bundle": "node tools/check-bundle.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.10",
    "@mui/material": "^5.14.10",
    "@reduxjs/toolkit": "^1.9.7",
    "axios": "^1.5.0",
    "date-fns": "^2.30.0",
    "docx": "^9.7.1",
    "react": "^19.0.0-beta",
    "react-dom": "^19.0.0-beta",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.20.0",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.28",
    "@types/react-dom": "^18.2.12",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "@vitejs/plugin-react": "^4.1.0",
    "eslint": "^8.50.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.2",
    "vitest": "^0.34.6"
  }
}
